# Copier ce fichier en .env pour le développement local. Ne JAMAIS committer le fichier .env réel.

# --- Sécurité service-à-service ---
# Doit être IDENTIQUE à AI_SERVICE_API_KEY côté logiflow-backend (.env) : c'est le même secret
# partagé, vérifié dans l'en-tête X-Internal-Api-Key. Voir docs/architecture.md.
INTERNAL_API_KEY=local-dev-key

# --- Base de données PROPRE au service IA (conversations du copilote, base de connaissance) ---
# Base "logiflow_ai" créée par logiflow-backend/docker/postgres/init/02-ai-database.sql.
# Jamais la base TMS "logiflow" : les données métier passent par les outils de Spring Boot.
DATABASE_URL=postgresql+psycopg://logiflow_ai:change-me-local-only@localhost:5433/logiflow_ai

# --- LLM : tout fournisseur compatible OpenAI (/chat/completions) ---
# Défaut : Groq, palier gratuit, très rapide. Clé : https://console.groq.com/keys
# Les quotas gratuits évoluent : consultez la page du fournisseur en cas d'erreur « Quota ».
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
#   Plus de requêtes/jour, un peu moins fiable sur les outils : LLM_MODEL=llama-3.1-8b-instant
#
# Autres fournisseurs (décommenter UN bloc) :
#   Google Gemini (palier gratuit) — clé : https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
#   Mistral (palier gratuit « Experiment ») — clé : https://console.mistral.ai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
#   OpenRouter (modèles « :free ») — clé : https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_S=30
LLM_STREAM_TIMEOUT_S=120
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embeddings (base de connaissance) : OPTIONNELS ---
# Vides = base de connaissance désactivée (Groq n'en fournit pas). Base/clé par défaut : celles
# du LLM. Exemple avec Gemini (gratuit) :
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBED_API_KEY=<clé Gemini>
# EMBED_MODEL=text-embedding-004
# Puis : make ingerer   (à refaire après tout changement de modèle d'embeddings)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# --- Rappel des outils du copilote exposés par Spring Boot ---
# Doit être IDENTIQUE à AI_SERVICE_CALLBACK_API_KEY côté logiflow-backend.
BACKEND_BASE_URL=http://localhost:8080
BACKEND_CALLBACK_API_KEY=local-dev-callback-key
BACKEND_TIMEOUT_S=15

# --- Copilote ---
COPILOTE_MAX_ITERATIONS_OUTILS=4
COPILOTE_HISTORIQUE_MAX=20
COPILOTE_TITRE_LLM=true
COPILOTE_BATTEMENT_S=10

# --- OSRM (routing, utilisé par l'agent itinéraire) ---
# Démo publique par défaut (gratuite, sans clé) ; pointer vers une instance auto-hébergée en prod.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=10

# --- Application ---
LOG_LEVEL=INFO
PORT=8000
