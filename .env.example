# Copier ce fichier en .env pour le développement local. Ne JAMAIS committer le fichier .env réel.

# --- Sécurité service-à-service ---
# Doit être IDENTIQUE à AI_SERVICE_API_KEY côté logiflow-backend (.env) : c'est le même secret
# partagé, vérifié dans l'en-tête X-Internal-Api-Key. Voir docs/architecture.md.
INTERNAL_API_KEY=local-dev-key

# --- Ollama (LLM auto-hébergé, utilisé par l'agent copilote) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=30

# --- OSRM (routing, utilisé par l'agent itinéraire) ---
# Démo publique par défaut (gratuite, sans clé) ; pointer vers une instance auto-hébergée en prod.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=10

# --- Application ---
LOG_LEVEL=INFO
PORT=8000
